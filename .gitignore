# data never committed
data/
.geoknit/
# results the example workflows write
examples/*/outputs/

# build output
geoknit/server/static/
dist/
build/
*.egg-info/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# tooling
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.vscode/
.idea/
*.tsbuildinfo

# export output of the synthetic example (geoknit export examples/synthetic/imd.geoknit)
examples/synthetic/imd.py
# local screenshot baselines (GEOKNIT_SCREENSHOTS=1); only the Linux ones are compared in CI
frontend/e2e/*-snapshots/*-win32.png
frontend/e2e/*-snapshots/*-darwin.png
