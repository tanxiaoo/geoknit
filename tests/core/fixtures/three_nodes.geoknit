      "source": "# geoknit: component\n# name: Repeat\n# category: Text\n# description: Repeat a text several times.\n# inputs:\n#   text: Text\n#   times: Number\n# outputs:\n#   repeated: Text\n\n# --- settings ---\ntimes = 2  # range: 1..10\nsep = \"-\"  # options: - | _ | +\n\n# --- code ---\nrepeated = sep.join([text] * int(times))\nprint(f\"repeated {int(times)} times\")\n"
